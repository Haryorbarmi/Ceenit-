# Copy to .env and fill in. Never commit .env.
TRONGRID_API_KEY=
DATABASE_URL=
# NETWORK=fake | nile | mainnet
NETWORK=fake

# Login codes. Leave blank while testing: the code is then shown in the app's test box.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=ceeneet_login_code
RESEND_API_KEY=
MAIL_FROM=

# Subscriptions (Paystack). Use the TEST secret key (sk_test_...) until launch.
# The two plan codes are filled in for you by: npm run paystack:setup
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_SELLER=
PAYSTACK_PLAN_BUSINESS=
